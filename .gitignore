*.d
unified_engine
*.a
__pycache__/

# No models or textures are redistributed from here. assets/ stays local and is
# covered by the *.obj and *.tga patterns above; tools/fetch_models.py pulls
# what it needs from the original sources at run time.
assets/

# working notes, kept local. memory.md is the raw scratch log and NOTES.md the
# curated engineering log; neither is published.
memory.md
NOTES.md

# compiled test binaries
src/tests/bin/

# local-only benchmarking and inspection tools. these measure or render for
# eyeballing rather than asserting, so they stay out of the repo. `make tools`
# builds whichever of them are present.
src/tests/bench.cpp
src/tests/bench_cull.cpp
src/tests/bench_tile.cpp
src/tests/profile_frame.cpp
src/tests/render_png.cpp
src/tests/test_wind.cpp

# CMake native build trees (the WSL Makefile builds in-tree; CMake does not)
build/
build-*/
CMakeUserPresets.json

# Nsight capture output. profile.ps1 writes to TEMP, but nsys drops
# intermediates in the working directory when a run is interrupted.
*.nsys-rep
*.ncu-rep
*.qdstrm
*.sqlite
